{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config",
  "description": "Global see-agent configuration",
  "type": "object",
  "properties": {
    "llm": {
      "type": "object",
      "properties": {
        "base_url": { "type": "string", "default": "https://api.openai.com/v1" },
        "api_key": { "type": "string" },
        "model": { "type": "string", "default": "gpt-4o" }
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
        "context_engine": { "type": "string", "default": "legacy" },
        "compact": {
          "type": "object",
          "properties": {
            "context_window": { "type": "integer", "default": 200000 },
            "target_ratio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.75 },
            "keep_recent": { "type": "integer", "minimum": 1, "default": 8 },
            "summary_model": { "type": "string", "default": "" }
          }
        }
      }
    },
    "screen": {
      "type": "object",
      "properties": {
        "max_images": { "type": "integer", "minimum": 0, "default": 5 },
        "screenshot_interval_ms": { "type": "integer", "minimum": 100, "default": 800 },
        "tool_delay_ms": { "type": "integer", "minimum": 0, "default": 200 },
        "scaling_enabled": { "type": "boolean", "default": true },
        "scaling_match": { "type": "string", "enum": ["aspect_ratio", "pixel_count", "exact"], "default": "aspect_ratio" },
        "show_overlay": { "type": "boolean", "default": true }
      }
    },
    "skills": {
      "type": "object",
      "properties": {
        "dirs": { "type": "array", "items": { "type": "string" }, "default": ["~/.see-agent/skills"] },
        "disabled": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "mcp": {
      "type": "object",
      "properties": {
        "servers": { "type": "object" },
        "disabled": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "tools": {
      "type": "object",
      "properties": {
        "disabled": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "profile": { "type": "string", "default": "default" },
        "extra_read": { "type": "array", "items": { "type": "string" }, "default": [] },
        "extra_write": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "plugins": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "dirs": { "type": "array", "items": { "type": "string" }, "default": ["~/.see-agent/plugins"] }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "language": { "type": "string", "default": "zh", "enum": ["zh", "en"] }
      }
    },
    "env": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
