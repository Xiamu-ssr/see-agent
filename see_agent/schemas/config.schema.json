{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config",
  "description": "Global see-agent configuration",
  "type": "object",
  "properties": {
    "llm": {
      "type": "object",
      "properties": {
        "base_url": { "type": "string", "default": "https://api.openai.com/v1" },
        "api_key": { "type": "string" },
        "model": { "type": "string", "default": "gpt-4o" }
      }
    },
    "language": { "type": "string", "default": "zh", "enum": ["zh", "en"] },
    "max_steps": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
    "max_images": { "type": "integer", "minimum": 0, "default": 5 },
    "screenshot_interval_ms": { "type": "integer", "minimum": 100, "default": 800 },
    "tool_delay_ms": { "type": "integer", "minimum": 0, "default": 200 },
    "scaling_enabled": { "type": "boolean", "default": true },
    "scaling_match": { "type": "string", "enum": ["aspect_ratio", "pixel_count", "exact"], "default": "aspect_ratio" },
    "skills_dirs": { "type": "array", "items": { "type": "string" }, "default": ["~/.see-agent/skills"] },
    "context_engine": { "type": "string", "default": "default" },
    "memory": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "provider": { "type": "string", "default": "file", "enum": ["file", "mem0"] },
        "mem0": {
          "type": "object",
          "properties": {
            "llm_base_url": { "type": "string" },
            "llm_api_key": { "type": "string" },
            "llm_model": { "type": "string" },
            "embedding_model": { "type": "string" },
            "storage_path": { "type": "string" }
          }
        }
      }
    },
    "compact": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "context_window": { "type": "integer", "default": 128000 },
        "target_ratio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.75 },
        "keep_recent": { "type": "integer", "minimum": 1, "default": 8 },
        "summary_model": { "type": "string", "default": "" }
      }
    },
    "env": { "type": "object", "additionalProperties": { "type": "string" } },
    "mcp_servers": { "type": "object" }
  }
}
