<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd agent for see-agent
     Install: cp com.see-agent.plist ~/Library/LaunchAgents/
     Load:    launchctl load ~/Library/LaunchAgents/com.see-agent.plist
     Unload:  launchctl unload ~/Library/LaunchAgents/com.see-agent.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.see-agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/see</string>
        <string>serve</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/see-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/see-agent.log</string>
</dict>
</plist>
