# systemd user service for see-agent
# Install: cp see-agent.service ~/.config/systemd/user/
# Enable:  systemctl --user enable --now see-agent

[Unit]
Description=see-agent server
After=network.target

[Service]
Type=forking
PIDFile=%h/.see-agent/server.pid
ExecStart=/usr/local/bin/see start
ExecStop=/usr/local/bin/see stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
