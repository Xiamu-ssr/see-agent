;; ---------------------------------------------------------------------------
;; see-agent Base Profile
;; Permissions shared by all see-agent agent processes.
;; Source: see-agent-base.sb
;; ---------------------------------------------------------------------------

;; 读取全局配置和 skill
(allow file-read*
    (home-subpath "/.see-agent/config.json")
    (home-subpath "/.see-agent/skills")
    (home-subpath "/.see-agent/schemas")
)

;; UDS 通信（agent 子进程 ↔ 主进程）
(allow file-read* file-write*
    (home-subpath "/.see-agent/run")
)

;; 临时文件
(allow file-read* file-write*
    (subpath "/tmp/see-agent")
)
